# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# Postgres with the pgvector extension (Supabase works as is)
DATABASE_URL=

# 32 random bytes, base64. Encrypts users' API keys at rest.
# Generate with: openssl rand -base64 32
EMI_MASTER_KEY=

# Optional: one OpenRouter key used for everybody who has not set their own.
# Leave empty for pure bring-your-own-key.
EMI_SHARED_OPENROUTER_KEY=

# Optional: comma-separated Telegram user ids allowed to talk to the bot.
# Empty means anyone.
EMI_ALLOWED_TELEGRAM_IDS=

# Models, as OpenRouter ids. The embedding model must support 1024 dimensions.
# The writer is Emi's voice. deepseek/deepseek-v4.1-flash is the best quality
# for the price (~$0.25 per 1000 replies); meta/muse-ember is a close, faster
# alternative; anthropic/claude-sonnet-5.5 sounds best but costs ~45x more.
# Compare any models on your own key with: npx tsx scripts/compare-models.ts
EMI_WRITER_MODEL=deepseek/deepseek-v4.1-flash
# The provider OpenRouter asks first for the writer. Prompt caching only works
# when the same provider answers every turn, and providers of one model differ
# in price up to 60x. Rank them by output price too: a reply is mostly cached
# input plus ~120 output tokens. baidu/fp8 is the cheapest DeepSeek option,
# deepinfra/fp8 the full-precision fallback; for meta/muse-ember use
# google-vertex/global. Others stay as fallbacks. Blank lets OpenRouter choose.
EMI_WRITER_PROVIDER=baidu/fp8,deepinfra/fp8
EMI_UTILITY_PROVIDER=
EMI_UTILITY_MODEL=z-ai/glm-5.3-flash
EMI_EMBEDDING_MODEL=qwen/qwen3-embedding-8b

# Chat replies show "typing" for about as long as a person would take, and
# bubbles arrive one by one. Task answers are never delayed. false sends at once.
EMI_PACING=true

# Read-only web search and page reading, using the same OpenRouter key/credits.
EMI_WEB_ENABLED=true

# Optional: image-capable model override; blank uses the same writer/persona.
EMI_VISION_MODEL=
